# StoryMagic model router configuration.
# NO provider is mandatory. Set only the keys you have. The server boots with none set.

# Path to a JSON config file (file precedence, below env overrides).
SM_CONFIG_PATH=./storymagic.config.json

# Enable only what you have keys for. Leave blank to disable that provider.
# SM_PROVIDER_GEMINI_API_KEY=
# SM_PROVIDER_OPENAI_API_KEY=
# SM_PROVIDER_ANTHROPIC_API_KEY=
# SM_PROVIDER_LOCAL_BASE_URL=http://localhost:11434

# OpenAI-compatible endpoints (reuse the OpenAI adapter with a custom baseUrl).
# Nous (Nous Research inference API) — keyed via a Bearer/JWT agent key from your Hermes instance.
# SM_PROVIDER_NOUS_API_KEY=
# SM_PROVIDER_NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
# OpenRouter — keyed via the standard OpenRouter API key (sk-or-...).
# SM_PROVIDER_OPENROUTER_API_KEY=
# SM_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: override per-task model ids and custom endpoints.
# SM_PROVIDER_GEMINI_MODELS_PAGE=gemini-2.0-flash
# SM_PROVIDER_GEMINI_MODELS_IMAGE=imagen-3.0-generate-002
# SM_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# SM_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
# SM_PROVIDER_LOCAL_MODELS_PAGE=llama3.1:8b
# SM_PROVIDER_NOUS_MODELS_PAGE=tencent/hy3:free
# SM_PROVIDER_OPENROUTER_MODELS_PAGE=openai/gpt-4o-mini
# SM_PROVIDER_OPENROUTER_MODELS_IMAGE=openai/dall-e-3

# Optional: set to "false" to disable prompt sanitization (not recommended).
# SM_SANITIZE=true

# Production build flag (serves from ./dist instead of Vite dev middleware).
# NODE_ENV=production

# ---- KPI instrumentation (all OPTIONAL — defaults to a privacy-safe no-op) ----
# StoryMagic sends NO analytics unless you configure exactly one backend below.
# See KPI_TRACKING.md. The "reads" metric = story_page_render events.

# Option A: Plausible (self-hosted or cloud). Set your configured domain.
# VITE_PLAUSIBLE_DOMAIN=storymagic.example.com
# VITE_PLAUSIBLE_HOST=https://plausible.io   # change to your self-hosted URL

# Option B: PostHog (free tier). Set your project API key (phc_...).
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx

# Option C: any custom endpoint that accepts a JSON POST {event, props, ts, url}.
# VITE_ANALYTICS_ENDPOINT=https://your-collector.example.com/event

# ---- Newsletter (Buttondown) ----
# Server-side only. The key never reaches the browser. Leave blank to disable
# the /api/subscribe endpoint gracefully (the signup form will inform users).
# Get a free key at https://buttondown.email (no card required).
# BUTTONDOWN_API_KEY=
